{
 "glowbop": 1,
 "type": "sign",
 "name": "GlowBop Logo Sign (7x7 Curtain Burst, 30 in)",
 "about": "A light-up sign: each spot is a hole in the board with a bunch of bulbs pushed through it. List the spots, then each strand's route through them in wiring order, starting at the plug. GlowBop lights the bunched bulbs, keeps lead, bridge and leftover bulbs dark, and maps every spot onto your wall.",
 "how_to_edit": {
  "units": "inches (any unit works, just stay consistent)",
  "spacing": "distance between neighbouring spots: GlowBop maps one spacing to one bulb spot on your wall",
  "cord": "where the plug / power cord enters the sign",
  "spots": "every lit spot: its number, where it is, and its color",
  "strands": "one entry per strand coming off the plug, in the light's bulb order. lead = dark bulbs from the plug to the first spot; route = spot numbers in wiring order; lit = bulbs bunched in each spot; bridge = dark bulbs between spots. Any route entry can be {\"spot\": n, \"lit\": 6, \"bridge\": 2} to change just that spot. Bulbs left at the end stay dark."
 },
